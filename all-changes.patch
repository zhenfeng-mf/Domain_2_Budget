-# This file should ensure the existence of records required to run the application in every environment (production,
-# development, test). The code here should be idempotent so that it can be executed at any point in every environment.
-# The data can then be loaded with the bin/rails db:seed command (or created alongside the database with db:setup).
-#
-# Example:
-#
-#   ["Action", "Comedy", "Drama", "Horror"].each do |genre_name|
-#     MovieGenre.find_or_create_by!(name: genre_name)
-#   end
+## db/seeds.rb
+
+# db/seeds.rb
+# Development/demo data only — do not use these credentials in production.
+
+if Rails.env.production?
+  abort "These demo seeds must not run in production."
+end
+
+ApplicationRecord.transaction do
+  # 1. Approver: no membership team
+  approver = User.find_or_create_by!(
+    email: "approver@example.com"
+  ) do |user|
+    user.name = "Alex"
+    user.role = :approver
+    user.team = nil
+    user.password = "DemoPassword123!"
+    user.password_confirmation = "DemoPassword123!"
+  end
+
+  unless approver.approver? && approver.team_id.nil?
+    raise "Existing demo approver does not match the new role/team rules."
+  end
+
+  # 2. Teams: both assigned to Alex
+  teams = ["Team Alpha", "Team Beta"].map do |name|
+    team = Team.find_or_create_by!(name: name) do |record|
+      record.approver = approver
+    end
+
+    unless team.approver_id == approver.id
+      raise "#{name} already has a different approver."
+    end
+
+    team
+  end
+
+  # 3. Members: each belongs to exactly one team
+  member_data = [
+    ["Taylor", "alpha1@example.com", teams[0]],
+    ["Morgan", "alpha2@example.com", teams[0]],
+    ["Casey",  "beta1@example.com",  teams[1]],
+    ["Riley",  "beta2@example.com",  teams[1]]
+  ]
+
+  member_data.each do |name, email, team|
+    member = User.find_or_create_by!(email: email) do |user|
+      user.name = name
+      user.role = :member
+      user.team = team
+      user.password = "DemoPassword123!"
+      user.password_confirmation = "DemoPassword123!"
+    end
+
+    unless member.member? && member.team_id == team.id
+      raise "#{email} already exists with a different role or team."
+    end
+  end
+
+  # 4. Shared categories
+  categories = ["交通費", "書籍費", "会議費"].map do |name|
+    Category.find_or_create_by!(name: name)
+  end
+
+  # 5. One current-month budget per team/category
+  teams.each do |team|
+    categories.each do |category|
+      Budget.find_or_create_by!(
+        team: team,
+        category: category,
+        year_month: MonthBucket.current
+      ) do |budget|
+        budget.amount = 100_000
+        budget.approved_total = 0
+      end
+    end
+  end
+end
+
+puts "Demo data ready."
+puts "Approver: approver@example.com"
+puts "Members: alpha1@example.com, alpha2@example.com"
+puts "         beta1@example.com, beta2@example.com"
+puts "Password for newly created accounts: DemoPassword123!"
+
+
