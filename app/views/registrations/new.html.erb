<% content_for :title, "新規登録 | Budget App" %>

<h1 class="mb-6 text-2xl font-semibold">メンバー登録</h1>

<% if @user.errors.any? %>
  <div role="alert" class="mb-4 theme-alert theme-alert-error">
    <p>入力内容を確認してください：</p>
    <ul class="list-disc pl-5">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: signup_path, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, "名前", class: "mb-1 block" %>
    <%= form.text_field :name, required: true, autocomplete: "name", class: "theme-control w-full" %>
  </div>
  <div>
    <%= form.label :email, "メールアドレス", class: "mb-1 block" %>
    <%= form.email_field :email, required: true, autocomplete: "email", class: "theme-control w-full" %>
  </div>
  <div>
    <%= form.label :team_id, "チーム", class: "mb-1 block" %>
    <%= form.collection_select :team_id, @teams, :id, :name, { prompt: "チームを選択してください" }, { required: true, class: "theme-control w-full" } %>
  </div>
  <div>
    <%= form.label :password, "パスワード", class: "mb-1 block" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", class: "theme-control w-full" %>
  </div>
  <div>
    <%= form.label :password_confirmation, "パスワード（確認）", class: "mb-1 block" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "theme-control w-full" %>
  </div>
  <%= form.submit "登録する", class: "theme-button" %>
<% end %>

<p class="mt-6">すでにアカウントがありますか？ <%= link_to "ログイン", login_path, class: "theme-link" %></p>
